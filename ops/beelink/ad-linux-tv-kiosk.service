[Unit]
Description=ad-linux-tv Firefox kiosk on tty1 (labwc)
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service
Wants=systemd-logind.service dbus.socket
Conflicts=getty@tty1.service sddm.service
ConditionPathExists=/dev/tty0
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=ad-tv
Group=ad-tv
PAMName=ad-linux-tv-kiosk
Environment=HOME=/home/ad-tv
Environment=AD_LINUX_TV_KIOSK=1
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=labwc
Environment=MOZ_ENABLE_WAYLAND=1
Environment=AD_LINUX_TV_WINDOWED=1
ExecStartPre=+/usr/bin/chvt 1
ExecStart=/usr/bin/labwc -C /etc/ad-linux-tv/labwc -S /usr/local/libexec/ad-linux-tv/tv-session.sh
ExecStopPost=+/usr/bin/chvt 2
StandardInput=tty-fail
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
Restart=always
RestartSec=5


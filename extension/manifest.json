{
  "manifest_version": 3,
  "name": "ad-linux-tv bridge",
  "version": "0.4.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "ad-linux-tv@aadegtyarev.github.io",
      "strict_min_version": "157.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "tab_storage.js",
      "player_volume.js",
      "player_media.js",
      "view_policy.js",
      "owned_tabs.js",
      "command_ledger.js",
      "tabs.js",
      "bridge.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "launcher.js"
      ]
    }
  ]
}
